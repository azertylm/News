# ==============================================================================
# ÉCOSYSTÈME ALPHABETTE (Hub central : http://alphabette.fr)
# Architecture Moteur IA Souveraine & Résiliente — Mistral AI Exclusif
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Variables standardisées Moteur IA (Mistral AI Exclusif)
# ------------------------------------------------------------------------------
# URL de base de l'API IA :
# - Production Cloud Mistral : https://api.mistral.ai/v1
# - Développement local Mac (Ollama / Metal) : http://localhost:11434/v1 ou http://localhost:11434
AI_BASE_URL="https://api.mistral.ai/v1"

# Clé API Mistral (Clé propriétaire Alphabette pour période d'essai 7 jours ou mode managé)
# L'utilisateur en mode BYOK peut également renseigner sa propre clé dans l'interface
AI_API_KEY="MY_MISTRAL_API_KEY"

# Modèle officiel Mistral AI :
# - mistral-small-latest (défaut haute performance)
# - mistral-large-latest (raisonnement d'investigation avancé)
# - mistral-nemo (recommandé en local Mac / Metal sous Ollama)
MISTRAL_MODEL="mistral-small-latest"

# ------------------------------------------------------------------------------
# 2. Développement Local Mac (Metal / Ollama)
# ------------------------------------------------------------------------------
LOCAL_AI_URL="http://localhost:11434"
LOCAL_AI_MODEL="mistral-nemo"
AI_LOCAL_TIMEOUT_MS="4000"

# ------------------------------------------------------------------------------
# 3. Environnement & Hub Alphabette
# ------------------------------------------------------------------------------
APP_URL="MY_APP_URL"
ALPHABETTE_HUB_URL="http://alphabette.fr"

# Rétrocompatibilité / Secours de développement AI Studio
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
