# ==============================================================================
# ÉCOSYSTÈME ALPHABETTE (Fondateur: Valentin RICHAUD - Hébergement OVH souverain)
# Architecture Moteur IA Hybride, Résiliente & Souveraine (3 Phases)
# ==============================================================================

# Phase 1 (Actuelle - Prototypage & Conception)
# Clé Google Gemini (injectée automatiquement dans Google AI Studio ou via Secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Sélecteur de fournisseur d'IA : 'gemini' | 'hybrid_mistral' (défaut: 'gemini' en phase 1)
# - 'gemini' : Appelle Google Gemini (modèle gemini-3.8-flash)
# - 'hybrid_mistral' : Tente le serveur local puis bascule automatiquement sur Mistral Cloud
AI_PROVIDER="gemini"

# Phase 2 (Production Cible - Moteur Local Souverain On-Premises)
# URL du serveur local dédié haute performance exécutant Ollama ou vLLM (0€/inférence, données 100% locales)
LOCAL_AI_URL="http://localhost:11434"

# Modèle open-source exécuté sur la machine locale (ex: mistral-nemo, mistral-small, mistral:latest)
LOCAL_AI_MODEL="mistral-nemo"

# Délai maximum d'attente du serveur local avant déclenchement du secours (en millisecondes : 3000 à 5000ms)
AI_LOCAL_TIMEOUT_MS="4000"

# Phase 3 (Résilience & Secours Cloud Européen)
# Clé API officielle Mistral AI (hébergée en France / Union Européenne)
# Utilisée en bascule automatique transparente si le serveur local est éteint, en panne ou en timeout
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"

# Modèle Mistral AI Cloud officiel (ex: mistral-small-latest, mistral-large-latest)
MISTRAL_MODEL="mistral-small-latest"

# APP_URL: URL où l'application est déployée
APP_URL="MY_APP_URL"
